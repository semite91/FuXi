# Copy this file to .env.test and fill the values. Never commit .env.test.
# FUXI_DB_NAME must end with _test. This database is dropped before every test run.

# PostgreSQL connection
FUXI_DB_HOST=
FUXI_DB_PORT=
FUXI_DB_NAME=
FUXI_DB_USER=
FUXI_DB_PASSWORD=

# Origins that may call the API, joined with a comma
FUXI_CORS_ORIGINS=

# Notion sign-in. The tests answer for Notion, so these can stay empty.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
FUXI_APP_URL=

# Google Drive sign-in. The tests answer for Google, so these can stay empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Spotify sign-in. The tests answer for Spotify, so these can stay empty.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# URLs that the frontend calls. Vite exposes only keys that start with VITE_
VITE_FUXI_API_URL=
VITE_FUXI_RAG_URL=

# Web push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push services
VAPID_SUBJECT=

# RAG engine (Python). Secrets are never committed.
RAG_GEMINI_API_KEY=
# TMDB API Read Access Token (themoviedb.org, Settings, API)
RAG_TMDB_TOKEN=
# gemini-3.8-flash when empty
RAG_GEMINI_MODEL=
# Similarity thresholds (0 to 1); text: the text model's own when empty (0.84 for e5, 0.5 for Qwen), image: 0.25 when empty
RAG_TEXT_THRESHOLD=
RAG_IMAGE_THRESHOLD=
# Embedding batch size; 8 when empty
RAG_BATCH_SIZE=
# Embedding device: auto (GPU only when PyTorch can run it, else CPU), cpu or cuda; auto when empty
RAG_EMBEDDING_DEVICE=
# Embedding precision: float32, float16 or bfloat16; float32 when empty
RAG_EMBEDDING_DTYPE=
# Longest text (tokens) the text model reads; longer Notion pages are cut into chunks of this size; 512 when empty (the model's own limit)
RAG_MAX_SEQ_LENGTH=
# Text embedding model; intfloat/multilingual-e5-small when empty (384 numbers, about 10 times faster than Qwen on a CPU).
# Another model gives vectors of another size, so the next build embeds every text again, and RAG_TEXT_THRESHOLD then needs
# another value (empty = the model's own: 0.84 for e5, 0.5 for Qwen/Qwen3-Embedding-0.6B and unknown models).
# Known: multilingual-e5 (also -base, -large), Qwen/Qwen3-Embedding-0.6B, embeddinggemma.
RAG_TEXT_MODEL=
# Minutes before Init_RAG retries a failed build; 10 when empty
RAG_REBUILD_COOLDOWN_MINUTES=
# true runs the tests that load real models and call real APIs
RAG_LIVE_TESTS=
