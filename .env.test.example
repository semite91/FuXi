# Copy this file to .env.test and fill the values. Never commit .env.test.
# FUXI_DB_NAME must end with _test. This database is dropped before every test run.

# PostgreSQL connection
FUXI_DB_HOST=
FUXI_DB_PORT=
FUXI_DB_NAME=
FUXI_DB_USER=
FUXI_DB_PASSWORD=

# Origins that may call the API, joined with a comma
FUXI_CORS_ORIGINS=

# URLs that the frontend calls. Vite exposes only keys that start with VITE_
VITE_FUXI_API_URL=
VITE_FUXI_RAG_URL=

# Web push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push services
VAPID_SUBJECT=
