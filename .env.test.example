# Copy this file to .env.test and fill the values. Never commit .env.test.
# FUXI_DB_NAME must end with _test. This database is dropped before every test run.

# PostgreSQL connection
FUXI_DB_HOST=
FUXI_DB_PORT=
FUXI_DB_NAME=
FUXI_DB_USER=
FUXI_DB_PASSWORD=

# Origins that may call the API, joined with a comma
FUXI_CORS_ORIGINS=

# Web push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
