# Copy this file to .env and fill the values. Never commit .env.

# PostgreSQL connection
FUXI_DB_HOST=
FUXI_DB_PORT=
FUXI_DB_NAME=
FUXI_DB_USER=
FUXI_DB_PASSWORD=

# Origins that may call the API, joined with a comma
FUXI_CORS_ORIGINS=

# Notion sign-in (a public integration at notion.so/profile/integrations). The secret stays in the API.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# The API's callback, as entered in the integration, for example http://localhost:5000/api/NotionCallback
NOTION_REDIRECT_URI=
# The app address the API sends the browser back to after the sign-in, for example http://localhost:5173
FUXI_APP_URL=

# Google Drive sign-in (an OAuth client in Google Cloud, consent screen in Testing). The API and the RAG engine read
# the client ID and secret; the engine uses them to refresh the Drive token at each build.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The API's callback, as entered in the OAuth client, for example http://localhost:5000/api/GoogleDriveCallback
GOOGLE_REDIRECT_URI=

# Spotify sign-in (an app in the Spotify Developer Dashboard, owned by a Premium account). The API and the RAG engine
# read the client ID and secret; the engine uses them to refresh the Spotify token at each build.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# The API's callback, as entered in the app. Spotify allows http only for a loopback address written as 127.0.0.1, for
# example http://127.0.0.1:5000/api/SpotifyCallback
SPOTIFY_REDIRECT_URI=

# URLs that the frontend calls. Vite exposes only keys that start with VITE_
VITE_FUXI_API_URL=
VITE_FUXI_RAG_URL=

# Web push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push services
VAPID_SUBJECT=

# RAG engine (Python). Secrets are never committed.
RAG_GEMINI_API_KEY=
# TMDB API Read Access Token (themoviedb.org, Settings, API)
RAG_TMDB_TOKEN=
# gemini-3.8-flash when empty
RAG_GEMINI_MODEL=
# Similarity thresholds (0 to 1); 0.5 and 0.25 when empty
RAG_TEXT_THRESHOLD=
RAG_IMAGE_THRESHOLD=
# Embedding batch size; 8 when empty
RAG_BATCH_SIZE=
# Embedding device: auto, cpu or cuda; auto when empty (GPU only when torch and the GPU can really run it)
RAG_EMBEDDING_DEVICE=
# Embedding precision: fp32, bf16 or fp16; fp32 when empty (fp16 is not used on the CPU)
RAG_EMBEDDING_PRECISION=
# Maximum tokens per text document; 512 when empty. Longer documents are split into windows, not truncated
RAG_MAX_SEQ_LENGTH=
# Minutes before Init_RAG retries a failed build; 10 when empty
RAG_REBUILD_COOLDOWN_MINUTES=
# true runs the tests that load real models and call real APIs
RAG_LIVE_TESTS=
