# Copy this file to .env and fill the values. Never commit .env.

# PostgreSQL connection
FUXI_DB_HOST=
FUXI_DB_PORT=
FUXI_DB_NAME=
FUXI_DB_USER=
FUXI_DB_PASSWORD=

# Origins that may call the API, joined with a comma
FUXI_CORS_ORIGINS=

# URLs that the frontend calls. Vite exposes only keys that start with VITE_
VITE_FUXI_API_URL=
VITE_FUXI_RAG_URL=

# Web push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push services
VAPID_SUBJECT=

# RAG engine (Python). Secrets are never committed.
RAG_NOTION_TOKEN=
RAG_GEMINI_API_KEY=
# Path of the Google service account JSON key, for example rag/secrets/drive_service_account.json
RAG_GOOGLE_SERVICE_ACCOUNT_FILE=
# gemini-3.8-flash when empty
RAG_GEMINI_MODEL=
# Similarity thresholds (0 to 1); 0.5 and 0.25 when empty
RAG_TEXT_THRESHOLD=
RAG_IMAGE_THRESHOLD=
# Embedding batch size; 16 when empty
RAG_BATCH_SIZE=
# Minutes before Init_RAG retries a failed build; 10 when empty
RAG_REBUILD_COOLDOWN_MINUTES=
# true runs the tests that load real models and call real APIs
RAG_LIVE_TESTS=
